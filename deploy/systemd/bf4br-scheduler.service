[Unit]
Description=BF4BR v1.0.6 central persona assignment scheduler
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=postgres
WorkingDirectory=/opt/bf4br
Environment="BF4BR_DSN=dbname=bf4_battle_reports user=postgres"
ExecStart=/opt/bf4br/.venv/bin/python -u -m bf4br.scheduler --publish --interval 10
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
